{
  "name": "libra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf:typegen": "node scripts/typegen.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "check": "npm run build && npm run cf:typegen && npm run typecheck && node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "lucide-react": "^1.55.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261010.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsqr": "^1.4.0",
    "miniflare": "^5.20261006.1-alpha",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.149.0"
  }
}
